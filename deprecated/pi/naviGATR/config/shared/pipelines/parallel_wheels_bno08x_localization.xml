<?xml version="1.0" encoding="UTF-8"?>
<!-- Localization shared by both parallel-wheel profiles, so the camera
     profile runs exactly the same odometry as the wheels-only one.

     Two forward-measuring wheels plus the gyro heading. The wheels cannot
     see sideways motion, so it is assumed zero: sideways slip or pushing
     goes unmeasured and camera landmarks do not correct it.
     planar_motion_integrator is used because the gyro is already folded
     in here as the heading constraint; it is not counted a second time.

     No InitialPlacement: the Brain supplies the field pose. Until it does,
     the pose is odometry only and is not a field position. -->
<Localization>
    <Observation id="tracking_motion" type="tracking_wheel_motion">
        <Wheels resource_id="wheel_geometry">
            <Use wheel_id="forward_wheel_a"/>
            <Use wheel_id="forward_wheel_b"/>
        </Wheels>
        <HeadingConstraint sensor_id="robot_imu" bias_samples="200"
                           max_calibration_travel_m="0.005" max_gap_ms="250"/>
        <LateralMotion assume="zero"/>
        <Output observation_id="tracking_motion"/>
    </Observation>
    <Estimator type="planar_motion_integrator">
        <Motion observation_id="tracking_motion"/>
    </Estimator>
    <History retention_s="5" capacity="1024" max_interpolation_gap_ms="100"/>
</Localization>
