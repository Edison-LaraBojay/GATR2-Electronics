# embed_assets.cmake
# Turns the viewer files into one C++ source implementing
# embeddedViewerAssets(). Run as a script:
#
#   cmake -DOUTPUT=<file.cpp> -DROOT=<dir> -DFILES="<rel1>;<rel2>" -P embed_assets.cmake
#
# Each entry of FILES is "served/path=source/path" (source relative to ROOT)
# or a plain relative path served under its own name.

if(NOT OUTPUT OR NOT ROOT OR NOT FILES)
    message(FATAL_ERROR "embed_assets.cmake needs OUTPUT, ROOT and FILES")
endif()

function(content_type_for path out)
    string(TOLOWER "${path}" lower)
    if(lower MATCHES "\\.html$")
        set(${out} "text/html; charset=utf-8" PARENT_SCOPE)
    elseif(lower MATCHES "\\.js$")
        set(${out} "text/javascript; charset=utf-8" PARENT_SCOPE)
    elseif(lower MATCHES "\\.css$")
        set(${out} "text/css; charset=utf-8" PARENT_SCOPE)
    elseif(lower MATCHES "\\.json$")
        set(${out} "application/json" PARENT_SCOPE)
    elseif(lower MATCHES "\\.svg$")
        set(${out} "image/svg+xml" PARENT_SCOPE)
    elseif(lower MATCHES "\\.png$")
        set(${out} "image/png" PARENT_SCOPE)
    elseif(lower MATCHES "\\.ico$")
        set(${out} "image/x-icon" PARENT_SCOPE)
    else()
        set(${out} "application/octet-stream" PARENT_SCOPE)
    endif()
endfunction()

set(body "// generated by cmake/embed_assets.cmake; do not edit\n")
string(APPEND body "#include \"inspection/viewer_assets.h\"\n\nnamespace navigatr\n{\n\nnamespace\n{\n\n")
set(table "")
set(index 0)
foreach(entry IN LISTS FILES)
    if(entry MATCHES "^([^=]+)=(.+)$")
        set(served "${CMAKE_MATCH_1}")
        set(source "${CMAKE_MATCH_2}")
    else()
        set(served "${entry}")
        set(source "${entry}")
    endif()
    set(full "${ROOT}/${source}")
    if(NOT EXISTS "${full}")
        message(FATAL_ERROR "embed_assets: missing ${full}")
    endif()
    file(READ "${full}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    # "0xAB," per byte, 24 bytes per line
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n" hex "${hex}")
    content_type_for("${served}" ctype)
    string(APPEND body "const unsigned char kAsset${index}[] = {\n${hex}\n0x00};\n")
    string(APPEND table "    {\"${served}\", \"${ctype}\", kAsset${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND body "\nconst EmbeddedAsset kAssets[] = {\n${table}};\n\n} // namespace\n\n")
string(APPEND body "const EmbeddedAsset* embeddedViewerAssets(std::size_t& count) {\n")
string(APPEND body "    count = ${index};\n    return kAssets;\n}\n\n} // namespace navigatr\n")
file(WRITE "${OUTPUT}" "${body}")
