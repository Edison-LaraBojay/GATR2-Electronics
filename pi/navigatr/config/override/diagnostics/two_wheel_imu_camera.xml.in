<?xml version="1.0" encoding="UTF-8"?>
<!--
Complete the matching robot, camera, and local pipeline templates, then
replace the body-display tokens below and save this file without .in.
See docs/setup.md for the complete build, calibration, and launch guide.

The two wheels are channels A and C: one forward-measuring wheel and one
lateral wheel. No encoder B or third-wheel calibration is required.
Initial field placement is configured in two_wheel_imu_camera_pipeline.xml.
Calibration labels are reader notes and do not affect runtime.
-->
<Configuration id="override_two_wheel_imu_camera_diagnostic">
    <ConfigurationName>Override two-wheel camera IMU diagnostic</ConfigurationName>
    <Loop rate_hz="100"/>
    <Inspection enabled="true" bind="127.0.0.1" port="8765"
                snapshot_hz="20" preview_hz="5" preview_quality="70" preview_max_width="640">
        <!-- Display only: center offsets are body center relative to the
             robot pose origin; they do not configure camera extrinsics. -->
        <RobotBody calibration_status="UNCONFIGURED"
                   length_m="@MEASURE_BODY_LENGTH_M@"
                   width_m="@MEASURE_BODY_WIDTH_M@"
                   height_m="@MEASURE_BODY_HEIGHT_M@"
                   origin_x_m="@MEASURE_BODY_CENTER_FORWARD_M@"
                   origin_y_m="@MEASURE_BODY_CENTER_LEFT_M@"/>
    </Inspection>
    <Robot file="../../shared/robots/gatr2_two_wheel_as5047_imu.xml"/>
    <Robot file="../../shared/robots/gatr2_front_camera.xml"/>
    <Field file="../field.xml"/>
    <Pipeline file="two_wheel_imu_camera_pipeline.xml"/>
</Configuration>
