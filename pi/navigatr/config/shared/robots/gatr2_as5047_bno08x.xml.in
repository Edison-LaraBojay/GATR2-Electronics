<?xml version="1.0" encoding="UTF-8"?>
<!--
THIS IS AN INTENTIONALLY NON-RUNNABLE TEMPLATE.

Every @...@ token must be replaced with a measured/configured numeric value
and every calibration_status="UNCONFIGURED" must become provisional or
verified. Never replace a required value with zero merely to make parsing
pass. Save the completed file as gatr2_as5047_bno08x.xml; the diagnostic
profiles reference that name and cannot resolve until it exists.

This file owns the base physical robot: transports, encoder and IMU
channels, and wheel geometry. The camera stack (mount frame, device,
calibration, detector) lives in the separate gatr2_front_camera fragment so
wheel/IMU-only profiles never depend on it. Pipeline fragments only
reference these ids and never restate a measurement.

Known-good values already filled in: the Pico link (/dev/ttyAMA0 at 115200,
pico/src/config.h) and the brain link (UART5 /dev/ttyAMA5 at 115200, RS-485
enable GPIO 6, one way Pi to brain, docs/hardware.md).

BNO08x note: the IMU sits behind the Pico, so the Pi consumes it as a
telemetry channel. The Pico-side BNO08x SPI driver, its report
configuration, and the versioned acquisition handshake are firmware work in
progress; until they land, this channel is served by the current firmware
and the Pi-side contract is unchanged.
-->
<Robot>

    <Resources>
        <Resource id="pico_uart" type="linux_serial_link">
            <Device path="/dev/ttyAMA0"/>
            <Baud value="115200"/>
        </Resource>

        <Resource id="pico_telemetry" type="pico_telemetry">
            <Serial resource_id="pico_uart"/>
        </Resource>

        <Resource id="brain_uart" type="linux_serial_link">
            <Device path="/dev/ttyAMA5"/>
            <Baud value="115200"/>
            <DriverEnable gpio="6"/>
        </Resource>

        <!--
        Measured tracking-wheel geometry, robot body frame: origin at the
        surveyed robot pose origin, +x forward, +y left. radius_m is the
        loaded effective rolling radius, not the nominal wheel size.
        counts-per-revolution and electrical sign live on the sensor
        channels below; direction here is geometric.
        -->
        <Resource id="wheel_geometry" type="wheel_geometry">
            <Wheel id="left_wheel" sensor_id="tracking_encoder_a" label="left"
                   calibration_status="UNCONFIGURED"
                   radius_m="@MEASURE_LEFT_WHEEL_LOADED_RADIUS_M@"
                   position_x_m="@MEASURE_LEFT_WHEEL_X_M@"
                   position_y_m="@MEASURE_LEFT_WHEEL_Y_M@"
                   measurement_angle_deg="@MEASURE_LEFT_WHEEL_ANGLE_DEG@"
                   direction="@CONFIRM_LEFT_WHEEL_DIRECTION@"/>
            <Wheel id="right_wheel" sensor_id="tracking_encoder_b" label="right"
                   calibration_status="UNCONFIGURED"
                   radius_m="@MEASURE_RIGHT_WHEEL_LOADED_RADIUS_M@"
                   position_x_m="@MEASURE_RIGHT_WHEEL_X_M@"
                   position_y_m="@MEASURE_RIGHT_WHEEL_Y_M@"
                   measurement_angle_deg="@MEASURE_RIGHT_WHEEL_ANGLE_DEG@"
                   direction="@CONFIRM_RIGHT_WHEEL_DIRECTION@"/>
            <Wheel id="rear_wheel" sensor_id="tracking_encoder_c" label="rear"
                   calibration_status="UNCONFIGURED"
                   radius_m="@MEASURE_REAR_WHEEL_LOADED_RADIUS_M@"
                   position_x_m="@MEASURE_REAR_WHEEL_X_M@"
                   position_y_m="@MEASURE_REAR_WHEEL_Y_M@"
                   measurement_angle_deg="@MEASURE_REAR_WHEEL_ANGLE_DEG@"
                   direction="@CONFIRM_REAR_WHEEL_DIRECTION@"/>
        </Resource>
    </Resources>

    <Sensors>
        <Sensor id="tracking_encoder_a" type="pico_encoder_channel">
            <Source resource_id="pico_telemetry" channel="0"/>
            <Calibration counts_per_revolution="@VERIFY_ENCODER_A_CPR@"
                         invert="@CONFIRM_ENCODER_A_INVERT@"/>
        </Sensor>

        <Sensor id="tracking_encoder_b" type="pico_encoder_channel">
            <Source resource_id="pico_telemetry" channel="1"/>
            <Calibration counts_per_revolution="@VERIFY_ENCODER_B_CPR@"
                         invert="@CONFIRM_ENCODER_B_INVERT@"/>
        </Sensor>

        <Sensor id="tracking_encoder_c" type="pico_encoder_channel">
            <Source resource_id="pico_telemetry" channel="2"/>
            <Calibration counts_per_revolution="@VERIFY_ENCODER_C_CPR@"
                         invert="@CONFIRM_ENCODER_C_INVERT@"/>
        </Sensor>

        <Sensor id="robot_imu" type="pico_imu_channel">
            <Source resource_id="pico_telemetry" channel="imu"/>
            <Calibration invert="@CONFIRM_IMU_CCW_POSITIVE_INVERT@"/>
        </Sensor>
    </Sensors>

</Robot>
