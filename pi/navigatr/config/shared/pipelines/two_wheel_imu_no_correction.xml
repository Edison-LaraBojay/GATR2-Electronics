<?xml version="1.0" encoding="UTF-8"?>
<!-- Two-wheel + IMU odometry, no landmark correction. Two wheels cannot
     observe rotation alone, so the heading constraint is mandatory. The
     selected pair is one forward-measuring wheel plus the lateral rear
     wheel; confirm against the physical build before trusting it. -->
<Pipeline>

    <CommandCollection type="noop"/>

    <Localization>
        <Observation id="tracking_motion" type="tracking_wheel_motion">
            <Wheels resource_id="wheel_geometry">
                <Use wheel_id="left_wheel"/>
                <Use wheel_id="rear_wheel"/>
            </Wheels>
            <HeadingConstraint sensor_id="robot_imu" bias_samples="200"
                               max_calibration_travel_m="0.005"/>
            <Output observation_id="tracking_motion"/>
        </Observation>
        <Estimator type="planar_motion_integrator">
            <Motion observation_id="tracking_motion"/>
        </Estimator>
        <History retention_s="5" capacity="1024" max_interpolation_gap_ms="100"/>
    </Localization>

    <WorldEstimation>
        <Estimator id="none" type="noop"/>
    </WorldEstimation>

    <TargetResolution type="noop"/>

    <Publishing type="vex_brain">
        <Serial resource_id="brain_uart"/>
        <Health fresh_ms="150">
            <Encoder sensor_id="tracking_encoder_a"/>
            <Encoder sensor_id="tracking_encoder_c"/>
            <Gyro sensor_id="robot_imu"/>
        </Health>
    </Publishing>

</Pipeline>
