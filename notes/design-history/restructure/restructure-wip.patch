+// pipeline/commands/stage.h
+// make_commands and the step it returns.
+//
+//   collect_commands = make_commands(<Pipeline>, registry, slot context)
+//   commands_out     = collect_commands.run({previous, now, diagnostics})
+//
+// Reads the <CommandCollection> slot and builds the registered
+// implementation its type names; the step captures it.
+
+#pragma once
+#include <functional>
+#include <optional>
+#include <string>
+
+#include "config/config_node.h"
