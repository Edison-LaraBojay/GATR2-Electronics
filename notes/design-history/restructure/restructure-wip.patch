+// Starts the workers, then keeps the Brain profile boundary on this thread
+// until stop is set or the estimation worker ran max_cycles cycles (-1: no
+// limit). after_poll runs after each boundary check. False with err when
+// the workers cannot start.
+bool runThreaded(System& system, long max_cycles, const StopFlag& stop,
+                 const CycleCallback& after_poll, std::string& err);
+
+} // namespace core
