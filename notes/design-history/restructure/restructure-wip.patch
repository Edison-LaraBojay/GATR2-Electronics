+
+using framework::FunctionKey;
+using framework::FunctionRegistry;
+using framework::ResetFunction;
+
+using CommandsStep = std::function<CommandsOutput(const CommandsInput&)>;
+
+struct CommandsExecutable {
+    CommandsStep  run;
+    ResetFunction reset;
+    FunctionKey   type;
+    std::string   label; // diagnostics: CommandCollection/<type>
+};
+
+// pipeline is the <Pipeline> element. Nothing on failure.
+std::optional<CommandsExecutable> make_commands(const ConfigNode&          pipeline,
+                                                const FunctionRegistry&    functions,
+                                                SlotInitializationContext& context,
+                                                std::string&               err);
+
+} // namespace commands
