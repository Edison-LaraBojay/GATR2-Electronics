@@ -0,0 +1,41 @@
+// pipeline/publishing/stage.cpp
+
+#include "pipeline/publishing/stage.h"
+
+#include <memory>
+
+namespace navigatr
+{
+namespace publishing
+{
+
+using framework::readSlot;
+
+std::optional<PublishingExecutable> make_publishing(const ConfigNode&          pipeline,
+                                                    const FunctionRegistry&    functions,
+                                                    SlotInitializationContext& context,
+                                                    std::string&               err) {
+    ConfigNode  node;
+    FunctionKey type;
+    if (!readSlot(pipeline, "Publishing", node, type, err)) {
+        return std::nullopt;
+    }
+    const PublishingMakeFunction* factory = functions.find<PublishingMakeFunction>(type, err);
+    if (factory == nullptr) {
+        err = node.path() + ": " + err;
+        return std::nullopt;
+    }
+    std::shared_ptr<Publishing> publishing = (*factory)(node, context, err);
+    if (publishing == nullptr) {
+        return std::nullopt;
+    }
+    PublishingExecutable publish;
+    publish.run   = [publishing](const PublishingInput& in) { return publishing->run(in); };
+    publish.reset = [publishing] { publishing->reset(); };
+    publish.type  = type;
+    publish.label = "Publishing/" + type.value;
+    return publish;
+}
+
+} // namespace publishing
+} // namespace navigatr
