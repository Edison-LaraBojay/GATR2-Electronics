+// pipeline/commands/stage.cpp
+
+#include "pipeline/commands/stage.h"
+
+#include <memory>
+
+namespace navigatr
+{
+namespace commands
+{
+
+using framework::readSlot;
+
+std::optional<CommandsExecutable> make_commands(const ConfigNode&          pipeline,
+                                                const FunctionRegistry&    functions,
+                                                SlotInitializationContext& context,
+                                                std::string&               err) {
+    ConfigNode  node;
+    FunctionKey type;
+    if (!readSlot(pipeline, "CommandCollection", node, type, err)) {
+        return std::nullopt;
+    }
+    const CommandsMakeFunction* factory = functions.find<CommandsMakeFunction>(type, err);
+    if (factory == nullptr) {
+        err = node.path() + ": " + err;
+        return std::nullopt;
+    }
+    std::shared_ptr<Commands> commands = (*factory)(node, context, err);
+    if (commands == nullptr) {
+        return std::nullopt;
+    }
+    CommandsExecutable collect_commands;
+    collect_commands.run   = [commands](const CommandsInput& in) { return commands->run(in); };
+    collect_commands.reset = [commands] { commands->reset(); };
+    collect_commands.type  = type;
+    collect_commands.label = "CommandCollection/" + type.value;
+    return collect_commands;
+}
+
+} // namespace commands
+} // namespace navigatr
