diff --git a/pi/naviGATR/src/main.cpp b/pi/naviGATR/src/main.cpp
new file mode 100644
index 0000000..2756852
--- /dev/null
+++ b/pi/naviGATR/src/main.cpp
@@ -0,0 +1,137 @@
+// main.cpp
+// Parse, build, run, report: register the compiled factories, build the
+// configured system, run it (core/run.h), print (cli/report.h). A
+// device that fails to open is a build warning and a runtime status; a
+// configuration error exits before anything starts.
+//
+//   navigatr [--config_file <config.xml>] [--replay <resource_id>=<capture.bin>] [--cycles <n>]
+//            [--inline] [--inspect-port <port>]
+//
+// Default run mode starts the estimation and field workers and, when the
+// configuration enables it, the inspection service; SIGINT/SIGTERM stop the
+// service first, then the capture recorder, then the workers, then the
+// system. --inline runs every
+// stage on this thread at the loop rate instead (deterministic replay and
+// bench use; warned with the brain link, which needs the workers). --cycles
+// stops after n estimation cycles in either mode. --inspect-port enables
+// the inspection service on loopback at that port without editing the
+// profile.
+
+#include <csignal>
+#include <cstdint>
+#include <cstdio>
+#include <memory>
+#include <string>
+
+#include "cli/command_line.h"
+#include "cli/report.h"
+#include "core/run.h"
+#include "core/system.h"
+#include "debug/inspection/inspection_service.h"
+#include "navigatr_build_config.h"
+#include "pipeline/register_all.h"
+
+namespace
+{
+
+using navigatr::registerAll;
+using navigatr::cli::CommandLine;
+using navigatr::cli::EventSequence;
+using navigatr::cli::kDefaultConfigFile;
+using navigatr::cli::parseCommandLine;
+using navigatr::cli::printInspection;
+using navigatr::cli::printNewEvents;
+using navigatr::cli::printStartup;
+using navigatr::cli::printSummary;
+using navigatr::cli::printUsage;
+using navigatr::core::CycleCallback;
+using navigatr::core::runInline;
+using navigatr::core::runThreaded;
+using navigatr::core::StopFlag;
+using navigatr::core::System;
+using navigatr::framework::FunctionRegistry;
+using navigatr::inspection::InspectionConfig;
+using navigatr::inspection::InspectionService;
+
+using InspectionServicePtr = std::unique_ptr<InspectionService>;
+
+StopFlag g_stop = 0;
+
+void onSignal(int) { g_stop = 1; }
+
+// Started when the profile or --inspect-port enables it, else left null.
+bool startInspection(System& system, long inspect_port, InspectionServicePtr& service,
+                     std::string& err) {
+    InspectionConfig inspection = system.inspection();
+    if (inspect_port != 0) {
+        inspection.enabled = true;
+        inspection.port    = inspect_port;
+    }
+    if (!inspection.enabled) {
+        return true;
+    }
+    service = InspectionService::create(system, inspection, err);
+    return service != nullptr && service->start(err);
+}
+
+// Browsers first, then the capture recorder (a capture still recording is
+// closed as truncated), then the workers, then the system.
+void stopInOrder(System& system, InspectionService* service) {
+    if (service != nullptr) {
+        service->stop();
+    }
+    if (system.capture() != nullptr) {
+        system.capture()->stop();
+    }
+    system.stop();
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+    CommandLine command;
+    std::string err;
+    if (!parseCommandLine(argc, argv, kDefaultConfigFile, command, err)) {
+        std::fprintf(stderr, "%s\nRun navigatr --help for usage.\n", err.c_str());
+        return 2;
+    }
+    if (command.help) {
+        printUsage(kDefaultConfigFile);
+        return 0;
+    }
+
+    FunctionRegistry functions;
+    registerAll(functions);
+    std::fprintf(stderr, "config %s\n", command.config_path.c_str());
+    std::unique_ptr<System> system =
+        System::buildFromFile(command.config_path, functions, err, command.build);
+    if (system == nullptr) {
+        std::fprintf(stderr, "config error: %s\n", err.c_str());
+        return 1;
+    }
+    printStartup(*system, command.inline_mode);
+
+    InspectionServicePtr service;
+    if (!startInspection(*system, command.inspect_port, service, err)) {
+        std::fprintf(stderr, "inspection error: %s\n", err.c_str());
+        return 1;
+    }
+    if (service != nullptr) {
+        printInspection(*service);
+    }
+
+    std::signal(SIGINT, onSignal);
+    std::signal(SIGTERM, onSignal);
+    EventSequence       events_seen  = 0;
+    const CycleCallback print_events = [&] { printNewEvents(*system, events_seen); };
+    if (command.inline_mode) {
+        runInline(*system, command.max_cycles, g_stop, print_events);
+    } else if (!runThreaded(*system, command.max_cycles, g_stop, print_events, err)) {
+        std::fprintf(stderr, "start error: %s\n", err.c_str());
+        return 1;
+    }
+
+    stopInOrder(*system, service.get());
+    printSummary(*system);
+    return 0;
+}
