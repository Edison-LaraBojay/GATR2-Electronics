+using StopFlag      = volatile std::sig_atomic_t; // nonzero: stop, set by a signal handler
+using CycleCallback = std::function<void()>;
+
+// Every stage inline on this thread at the loop rate, until stop is set or
+// max_cycles cycles ran (-1: no limit). after_cycle runs after each cycle.
+void runInline(System& system, long max_cycles, const StopFlag& stop,
+               const CycleCallback& after_cycle);
