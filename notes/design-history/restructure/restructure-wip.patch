+    if (!readSlot(pipeline, "TargetResolution", node, type, err)) {
+        return std::nullopt;
+    }
+    const TargetResolutionMakeFunction* factory =
+        functions.find<TargetResolutionMakeFunction>(type, err);
+    if (factory == nullptr) {
+        err = node.path() + ": " + err;
+        return std::nullopt;
+    }
+    std::shared_ptr<TargetResolution> targets = (*factory)(node, context, err);
+    if (targets == nullptr) {
+        return std::nullopt;
+    }
+    TargetsExecutable resolve_targets;
+    resolve_targets.run   = [targets](const TargetResolutionInput& in) { return targets->run(in); };
+    resolve_targets.reset = [targets] { targets->reset(); };
+    resolve_targets.type  = type;
+    resolve_targets.label = "TargetResolution/" + type.value;
+    return resolve_targets;
+}
