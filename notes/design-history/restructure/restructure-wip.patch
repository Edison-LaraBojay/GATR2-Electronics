+// The <slot_name> element under <Pipeline> and its type. Every slot is
+// present and explicitly typed: an unused slot selects its category noop,
+// omission is an error, never an implicit default.
+inline bool readSlot(const ConfigNode& pipeline, const char* slot_name, ConfigNode& node,
+                     FunctionKey& type, std::string& err) {
+    node = pipeline.child(slot_name);
+    if (!node.valid()) {
+        err = pipeline.path() + " is missing " + slot_name +
+              "; select an implementation or the category noop";
+        return false;
+    }
+    type = FunctionKey{node.attr("type")};
+    if (type.empty()) {
+        err = node.path() + ": needs an explicit type";
+        return false;
+    }
+    return true;
+}
