+// pipeline/publishing/stage.h
+// make_publishing and the step it returns.
+//
+//   publish = make_publishing(<Pipeline>, registry, slot context)
+//   pub_out = publish.run({sensors, observations, ..., now})
+//
+// Reads the <Publishing> slot and builds the registered implementation its
+// type names; the step captures it.
+
+#pragma once
+#include <functional>
+#include <optional>
+#include <string>
+
+#include "config/config_node.h"
+#include "pipeline/framework/execution_context.h"
+#include "pipeline/framework/function_registry.h"
+#include "pipeline/framework/ids.h"
+#include "pipeline/framework/slot_init.h"
+#include "pipeline/publishing/contract.h"
+
+namespace navigatr
+{
+namespace publishing
+{
+
+using framework::FunctionKey;
+using framework::FunctionRegistry;
+using framework::ResetFunction;
+
+using PublishingStep = std::function<PublishingOutput(const PublishingInput&)>;
+
+struct PublishingExecutable {
+    PublishingStep run;
+    ResetFunction  reset;
+    FunctionKey    type;
+    std::string    label; // diagnostics: Publishing/<type>
+};
+
+// pipeline is the <Pipeline> element. Nothing on failure.
+std::optional<PublishingExecutable> make_publishing(const ConfigNode&          pipeline,
+                                                    const FunctionRegistry&    functions,
+                                                    SlotInitializationContext& context,
+                                                    std::string&               err);
+
+} // namespace publishing
+} // namespace navigatr
