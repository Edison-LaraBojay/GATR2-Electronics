+
+namespace navigatr
+{
+namespace core
+{
+
+using brain_profile::checkProfileCapabilities;
+using brain_profile::kProfileSensorPrefix;
+using brain_profile::parseBrainProfileConfig;
+using brain_profile::PicoOperation;
+using brain_profile::ProfileBinding;
+using brain_profile::profileReasonName;
+using brain_profile::SensorLossMonitor;
+using brain_profile::StationaryPrecheck;
+using brain_profile::writeProfileSubtrees;
+using brain_profile::writeWaitingLocalization;
+using capture::CaptureFault;
+using commands::ProfileStatus;
